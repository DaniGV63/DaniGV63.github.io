---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import Intro from '../components/home/Intro.astro';
import Work from '../components/home/Work.astro';
import Proofs from '../components/home/Proofs.astro';
import profile from '../data/profile.json';

const endesaRelated = {
  href: '/projects/danish-grid/',
  label: 'See the same method on public Danish data',
};
---

<BaseLayout>
  <Work>
    <Intro />
  </Work>

  <Section id="what-i-do" title="What I do">
    <Proofs items={profile.strengths} />
  </Section>

  <Section id="experience" title="Experience">
    <div>
      {
        profile.experience.map((job) => (
          <ExperienceItem
            role={job.role}
            company={job.company}
            period={job.period}
            location={job.location}
            context={job.context}
            highlights={job.featuredHighlights.map((index) => job.highlights[index])}
            related={job.id === 'endesa' ? endesaRelated : undefined}
          />
        ))
      }
    </div>
  </Section>

  <Section id="toolbox" title="Toolbox">
    <ul class="toolbox">
      {
        Object.entries(profile.skills).map(([group, tags]) => (
          <li>
            <strong>{group}.</strong> {tags.join(', ')}.
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="education" title="Education and languages">
    <div class="education">
      <ul>
        {
          profile.education.map((item) => (
            <li class="education__item">
              <strong>{item.degree}</strong>
              <span>{item.school}</span>
              <span class="education__period">{item.period}</span>
            </li>
          ))
        }
      </ul>
      <ul class="languages">
        {profile.languages.map((language) => <li>{language}</li>)}
      </ul>
    </div>
  </Section>
</BaseLayout>

<style>
  .toolbox {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
  }

  .toolbox li {
    color: var(--color-text-muted);
  }

  .toolbox strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .education {
    display: grid;
    gap: var(--space-8);
  }

  .education__item {
    display: grid;
    gap: 2px;
  }

  .education__item + .education__item {
    margin-top: var(--space-4);
  }

  .education__item span {
    color: var(--color-text-muted);
  }

  .education__period {
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .languages {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .education {
      grid-template-columns: 2fr 1fr;
    }
  }
</style>
