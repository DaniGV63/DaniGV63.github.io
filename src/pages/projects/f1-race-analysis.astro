---
// Spec: docs/F1_SPEC.md. D3 is loaded only on this page (via RaceExplorer).
import BaseLayout from '../../layouts/BaseLayout.astro';
import RaceExplorer from '../../components/f1/RaceExplorer.astro';
import LapComparison from '../../components/f1/LapComparison.astro';
import DriverPicker from '../../components/f1/DriverPicker.astro';
import meta from '../../data/f1/2021-abu-dhabi-grand-prix-r/meta.json';
import laps from '../../data/f1/2021-abu-dhabi-grand-prix-r/laps.json';
import track from '../../data/f1/2021-abu-dhabi-grand-prix-r/track.json';
import { formatLapTime } from '../../scripts/f1/types';
import type { LapRow, RaceMeta, SegFile, TrackData } from '../../scripts/f1/types';
import { analyseRace } from '../../lib/raceAnalysis';

const folder = '2021-abu-dhabi-grand-prix-r';

// Every number in the written analysis is computed here from the pipeline JSON.
const segFiles = import.meta.glob('../../data/f1/2021-abu-dhabi-grand-prix-r/seg/*.json', {
  eager: true,
  import: 'default',
}) as Record<string, SegFile>;
const analysis = analyseRace(
  meta as RaceMeta,
  laps as LapRow[],
  Object.fromEntries(Object.values(segFiles).map((file) => [file.driver, file])),
  track as TrackData,
);
const percent = (value: number): string => `${(value * 100).toFixed(0)}%`;
const [first, second, third] = analysis.rates;
const raceWinner = analysis.rates.find((rate) => rate.finish === 1);
const widest = analysis.parts.slice(0, 3);
const pitLaps = laps.filter((row) => row.pitIn || row.pitOut).length;
const compared = analysis.rates.length;
const retired = meta.drivers.length - compared;
const cleanTop = analysis.cleanRates.slice(0, 3);

const resultLine = `${first?.name} won ${percent(first!.rate)} of the parts they contested, ${second?.name} ${percent(second!.rate)} and ${third?.name} ${percent(third!.rate)}. With about ${analysis.fieldSize.toFixed(0)} cars per lap, an evenly matched field would win about ${percent(analysis.chance)} each.`;
const winnerLine =
  raceWinner && first && raceWinner.code !== first.code
    ? ` ${first.name} won more parts than ${raceWinner.name}, who won the race.`
    : '';
const widestLine = `The gap between the median driver and the best one is widest near ${widest
  .map((part) => `${part.corner} (${part.seconds.toFixed(2)} s)`)
  .join(', ')
  .replace(/, ([^,]*)$/, ' and $1')}. The five widest parts hold ${percent(analysis.topShare)} of the ${analysis.totalSpread.toFixed(1)} s per lap that separates the median driver from a lap stitched together from the best part times.`;
const approachLine = `The ${compared} drivers who finished the race are compared. Each lap is cut into 25 equal-distance parts, and in every part of every lap the fastest of them wins the part. Win rate is parts won divided by parts contested. All ${meta.totalLaps} laps and ${analysis.cells.toLocaleString('en')} lap-part comparisons are used.`;
const cleanLine = `All laps count, including the pit-stop laps and the safety-car laps. Without them the top three is ${analysis.sameOrder ? 'the same' : 'different'}: ${cleanTop.map((rate) => `${rate.code} ${percent(rate.rate)}`).join(', ')}.`;

const winner = meta.drivers.find((d) => d.finish === 1);

const timed = laps.filter((row) => row.isAccurate && row.lapTime !== null);
const fastest = timed.reduce((best, row) => (row.lapTime! < best.lapTime! ? row : best));
const fastestDriver = meta.drivers.find((d) => d.code === fastest.driver);

// A lap counts as "under safety car" when most drivers had track status 4 in it.
const scLaps = Array.from({ length: meta.totalLaps }, (_, i) => i + 1).filter((lap) => {
  const rows = laps.filter((row) => row.lap === lap);
  return rows.filter((row) => row.trackStatus?.includes('4')).length > rows.length / 2;
});

function toRanges(numbers: number[]): string {
  const ranges: string[] = [];
  for (const n of numbers) {
    const last = ranges.length - 1;
    const match = last >= 0 ? ranges[last]!.split('–') : [];
    if (match.length && Number(match[match.length - 1]) === n - 1) {
      ranges[last] = `${match[0]}–${n}`;
    } else {
      ranges.push(String(n));
    }
  }
  return ranges.join(', ');
}

const classification = meta.drivers
  .filter((d) => d.finish !== null)
  .slice(0, 10)
  .map((driver) => {
    const rows = laps.filter((row) => row.driver === driver.code);
    const best = rows
      .filter((row) => row.isAccurate && row.lapTime !== null)
      .reduce<number | null>((min, row) => (min === null || row.lapTime! < min ? row.lapTime : min), null);
    return { ...driver, best, stops: rows.filter((row) => row.pitIn).length };
  });
---

<BaseLayout
  title="F1 Race Analysis — Daniel Gómez Verde"
  description="Interactive analysis of the 2021 Abu Dhabi Grand Prix: a lap-by-lap comparison of drivers on a 3D circuit and the pace of the race."
>
  <div class="container intro">
    <p class="label">Project</p>
    <h1 class="title">
      <img src="/f1/f1.svg" alt="F1" width="84" height="21" />
      <span>Race Analysis</span>
    </h1>
    <p class="intro__lead">
      Who was faster, and where, in the {meta.year} {meta.event}: a lap-by-lap comparison
      and the pace of the race.
    </p>
  </div>

  <div class="container">
    <DriverPicker />
    <header class="race-head">
      <img src="/f1/f1.svg" alt="Formula 1" width="84" height="21" />
      <p class="race-head__title">{meta.year} · {meta.event} · Race</p>
    </header>
    <LapComparison />
    <RaceExplorer folder={folder} meta={meta} laps={laps} track={track} />
  </div>

  <section class="container facts" aria-labelledby="facts-title">
    <h2 id="facts-title" class="label">At a glance</h2>
    <ul class="facts__list">
      <li><strong>{meta.totalLaps}</strong> laps at {meta.circuit}</li>
      {winner && <li>Winner: <strong>{winner.name}</strong> ({winner.team})</li>}
      <li>
        Fastest lap: <strong>{fastestDriver?.name ?? fastest.driver}</strong>,
        lap {fastest.lap}, <span class="mono">{formatLapTime(fastest.lapTime)}</span>
      </li>
      {scLaps.length > 0 && <li>Laps with a safety-car period: <span class="mono">{toRanges(scLaps)}</span></li>}
    </ul>

    <div class="facts__table">
      <table>
        <caption>Top ten classified</caption>
        <thead>
          <tr><th scope="col">Pos</th><th scope="col">Driver</th><th scope="col" class="facts__team">Team</th><th scope="col">Best lap</th><th scope="col">Stops</th></tr>
        </thead>
        <tbody>
          {classification.map((row) => (
            <tr>
              <td class="mono">{row.finish}</td>
              <td>{row.name}</td>
              <td class="facts__team">{row.team}</td>
              <td class="mono">{formatLapTime(row.best)}</td>
              <td class="mono">{row.stops}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container reading" aria-labelledby="reading-title">
    <h2 id="reading-title" class="label">Reading the race</h2>
    <div class="reading__grid">
      <div>
        <h3>Question</h3>
        <p>
          Which driver was fastest in each part of the circuit, by how much, and where were the
          differences decided?
        </p>
      </div>
      <div>
        <h3>Approach</h3>
        <p>{approachLine}</p>
      </div>
      <div class="reading__wide">
        <h3>Result</h3>
        <p>{resultLine}{winnerLine}</p>
        <p>{widestLine}</p>
      </div>
      <div>
        <h3>Limitations</h3>
        <ul>
          <li>{cleanLine}</li>
          <li>Part times come from integrating car speed; differences below about 0.05 s are noise.</li>
          <li>Fuel load, tyre age and traffic are not controlled for.</li>
          <li>The {retired} drivers who retired are left out, so the comparison is among classified finishers.</li>
        </ul>
      </div>
      <div>
        <h3>What I'd do next</h3>
        <ul>
          <li>Control for tyre age and fuel with a regression per stint.</li>
          <li>Add qualifying laps as a pace reference for each driver.</li>
          <li>Run the same pipeline on other races and compare circuits.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="container method" aria-labelledby="method-title">
    <h2 id="method-title" class="label">Data</h2>
    <p>
      Lap and sector times and car positions come from the open-source FastF1
      library. A local Python pipeline cleans them, thins each lap to a point
      every 50 m and writes static JSON that the page loads on demand.
    </p>
  </section>

  <div class="container back"><a href="/">← Back to the home page</a></div>

  <Fragment slot="legal">
    Data via the open-source FastF1 library. This is an unofficial,
    non-commercial project and is not associated with Formula 1. F1 and related
    marks are trademarks of Formula One Licensing B.V.
  </Fragment>
</BaseLayout>

<style is:global>
  html:root {
    --font-sans: 'Saira Variable', 'Schibsted Grotesk Variable', system-ui, sans-serif;
    --font-mono: 'Saira Variable', 'Schibsted Grotesk Variable', system-ui, sans-serif;
  }
</style>

<style>
  .title {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .title img {
    display: block;
    height: 0.75em;
    width: auto;
  }

  .intro {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-12) var(--space-6);
  }

  .intro__lead {
    color: var(--color-text-muted);
  }

  .race-head {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }

  .race-head__title {
    font-size: var(--step-1);
    font-weight: 800;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .reading {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  .reading__grid {
    display: grid;
    gap: var(--space-6);
  }

  .reading h3 {
    margin-bottom: var(--space-2);
    font-size: var(--step-0);
  }

  .reading ul {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-4);
    list-style: disc;
  }

  .reading p + p {
    margin-top: var(--space-3);
  }

  @media (min-width: 720px) {
    .reading__grid {
      grid-template-columns: 1fr 1fr;
    }

    .reading__wide {
      grid-column: 1 / -1;
    }
  }

  .facts,
  .method {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  .facts__list {
    display: grid;
    gap: var(--space-2);
  }

  .facts__table {
    overflow-x: auto;
  }

  .facts__table table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .facts__table caption {
    text-align: left;
    padding-bottom: var(--space-2);
    color: var(--color-text-muted);
  }

  .facts__table th,
  .facts__table td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    white-space: nowrap;
  }

  .back {
    margin-top: var(--space-12);
  }

  @media (max-width: 540px) {
    .facts__team {
      display: none;
    }

    .facts__table th,
    .facts__table td {
      padding-inline: var(--space-2);
    }
  }
</style>
