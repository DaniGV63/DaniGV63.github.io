---
// Race pace: lap time or race gap per lap with tyre strips. Logic lives in
// src/scripts/f1/. Also owns the #f1-data payload that LapComparison reads.
import type { LapRow, RaceMeta, TrackData } from '../../scripts/f1/types';

interface Props {
  folder: string;
  meta: RaceMeta;
  laps: LapRow[];
  track: TrackData;
}

const { folder, meta, laps, track } = Astro.props;
const payload = JSON.stringify({ folder, meta, laps, track }).replace(/</g, '\\u003c');
---

<section class="f1" id="f1-explorer" aria-labelledby="pace-title">
  <script type="application/json" id="f1-data" set:html={payload} is:inline />

  <div class="f1__bar">
    <div>
      <p class="f1__kicker" id="pace-title">Race pace</p>
      <p class="f1__hint">
        How the race unfolded for the drivers selected above. Dots mark a new set of tyres, filled
        with its compound. Click a lap for its sector times · ← → change lap.
      </p>
    </div>
    <label class="f1__field">
      <span>View</span>
      <select id="pace-view">
        <option value="lap">Lap time</option>
        <option value="gap">Race gap</option>
      </select>
    </label>
  </div>

  <ul class="pace-legend pace-drivers" id="pace-drivers" aria-label="Selected drivers"></ul>

  <ul class="pace-legend" aria-label="Tyre compounds and markers">
    <li><span class="dot" style="background:#e10600"></span>Soft</li>
    <li><span class="dot" style="background:#f5c518"></span>Medium</li>
    <li><span class="dot" style="background:#d4d4d8"></span>Hard</li>
    <li><span class="pace-legend__sc"></span>Safety car</li>
  </ul>

  <div class="f1__view">
    <div
      class="f1__chart"
      id="pace-chart"
      tabindex="0"
      role="group"
      aria-label="Race pace chart. Use the left and right arrow keys to change lap."
    >
    </div>
    <div class="f1__tooltip" id="pace-tooltip" hidden></div>
  </div>

  <div class="f1__tablewrap">
    <table class="f1__table">
      <caption id="pace-caption">Click a lap in the chart to see its sector times.</caption>
      <thead>
        <tr>
          <th scope="col">Driver</th>
          <th scope="col">S1</th>
          <th scope="col">S2</th>
          <th scope="col">S3</th>
          <th scope="col">Lap</th>
          <th scope="col">Tyre</th>
        </tr>
      </thead>
      <tbody id="pace-table-body"></tbody>
    </table>
  </div>
</section>

<style is:global>
  .f1 {
    /* Same light/dark switch as the rest of the site (color-scheme). */
    --f1-bg: light-dark(#f5f6f5, #0b0b0f);
    --f1-panel: light-dark(#ffffff, #15151c);
    --f1-line: light-dark(#dfe3e1, #2a2a35);
    --f1-text: light-dark(#14171a, #f5f5f7);
    --f1-muted: light-dark(#566067, #a1a1aa);
    --f1-red: #e10600;
    --f1-ink: light-dark(#14171a, #ffffff);
    padding: var(--space-4);
    background: var(--f1-bg);
    color: var(--f1-text);
    border-radius: var(--radius);
    border-top: 4px solid var(--f1-red);
    display: grid;
    gap: var(--space-4);
  }

  .f1__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    align-items: end;
  }

  .f1__kicker {
    font-weight: 800;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .f1__hint {
    color: var(--f1-muted);
    font-size: var(--step--1);
  }

  .f1__field {
    display: grid;
    gap: 2px;
    font-size: 0.75rem;
    color: var(--f1-muted);
  }

  .f1 select,
  .f1 button {
    font: inherit;
    color: var(--f1-text);
    background: var(--f1-panel);
    border: 1px solid var(--f1-line);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
  }

  .f1__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .f1-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    opacity: 0.55;
  }

  .f1-chip[aria-pressed='true'] {
    opacity: 1;
    border-color: var(--f1-text);
  }

  .f1__logo {
    display: block;
    margin-bottom: var(--space-2);
  }

  .f1-chip__logo {
    border-radius: 4px;
    background: #fff;
    object-fit: contain;
  }

  .f1-chip__swatch {
    width: 4px;
    height: 1.1em;
    border-radius: 2px;
  }

  .f1__lapbar {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: var(--space-3);
  }

  .f1__lapbar input[type='range'] {
    width: 100%;
    accent-color: var(--f1-red);
  }

  .f1__views {
    display: grid;
    gap: var(--space-4);
  }

  .f1__view {
    position: relative;
    min-width: 0;
    padding: var(--space-3);
    background: var(--f1-panel);
    border: 1px solid var(--f1-line);
    border-radius: var(--radius);
  }

  .f1__title {
    font-size: var(--step--1);
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-2);
  }

  .f1__chart svg,
  .f1__map svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .f1__map {
    max-width: 520px;
    margin-inline: auto;
  }

  .f1__tooltip {
    position: absolute;
    z-index: 2;
    padding: var(--space-2) var(--space-3);
    background: var(--f1-panel);
    border: 1px solid var(--f1-line);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: pre;
    pointer-events: none;
  }

  .f1__legend {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--f1-muted);
  }

  .f1__legend span {
    display: inline-block;
    width: 12px;
    height: 4px;
    margin-right: 6px;
    vertical-align: middle;
  }

  .f1-axis text,
  .f1-axis-label {
    fill: var(--f1-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .f1-axis path,
  .f1-axis line {
    stroke: var(--f1-line);
  }

  .f1-lap__line {
    fill: none;
    stroke-width: 1.2;
    opacity: 0.4;
  }

  .f1-lap:hover .f1-lap__line {
    opacity: 1;
    stroke-width: 2.4;
  }

  .f1-lap__hit {
    fill: none;
    stroke: transparent;
    stroke-width: 12;
    cursor: pointer;
  }

  .f1-lap__halo {
    fill: none;
    stroke: var(--f1-ink);
    stroke-width: 6;
    opacity: 0.9;
  }

  .f1-lap--active .f1-lap__line {
    stroke-width: 3;
    opacity: 1;
  }

  .f1-track {
    fill: none;
    stroke: light-dark(#d3d8d6, #2c2c38);
    stroke-linejoin: round;
  }

  .f1-trace {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .f1-corner,
  .f1-map-note {
    fill: var(--f1-muted);
    font-family: var(--font-mono);
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .f1-boundary {
    fill: var(--f1-ink);
  }

  .f1-start {
    fill: none;
    stroke: var(--f1-red);
    stroke-width: 6;
  }

  .f1__tablewrap {
    overflow-x: auto;
  }

  .f1__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .f1__table caption {
    padding-bottom: var(--space-2);
    text-align: left;
    color: var(--f1-muted);
  }

  .f1__table th,
  .f1__table td {
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--f1-line);
    text-align: right;
  }

  .f1__table th:first-child,
  .f1__table td:first-child {
    text-align: left;
  }

  .f1__table .is-primary td:first-child {
    color: var(--f1-red);
    font-weight: 700;
  }

  .f1__table .is-best {
    color: light-dark(#7e22ce, #c084fc);
    font-weight: 700;
  }

  .pace-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--f1-muted);
  }

  .pace-legend span {
    display: inline-block;
    width: 12px;
    height: 8px;
    margin-right: 6px;
    vertical-align: middle;
  }

  .pace-legend__sc {
    background: var(--pace-sc);
  }

  .pace-drivers span {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    border-radius: 4px;
  }

  .pace-legend .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .f1 {
    --pace-sc: light-dark(rgb(20 23 26 / 0.1), rgb(255 255 255 / 0.12));
  }

  .pace-sc {
    fill: var(--pace-sc);
  }

  .pace-line {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .pace-dot {
    stroke-width: 2;
  }

  .pace-zero {
    stroke: var(--f1-muted);
    stroke-dasharray: 2 3;
  }

  .pace-selected {
    stroke: var(--f1-ink);
    stroke-width: 1.5;
  }

  .pace-hit {
    fill: transparent;
    cursor: pointer;
  }

  #pace-chart:focus-visible {
    outline: 2px solid var(--color-focus, currentColor);
    outline-offset: 2px;
  }

  @media (min-width: 900px) {
    .f1 {
      padding: var(--space-6);
    }

    .f1__views {
      grid-template-columns: 1.1fr 1fr;
    }
  }
</style>

<script>
  import '../../scripts/f1/pace';
</script>
