---
interface Props {
  role: string;
  company: string;
  period: string;
  location: string;
  context: string;
  highlights: readonly string[];
  /** Optional link to a public project that shows the same kind of work. */
  related?: { href: string; label: string };
}

const { role, company, period, location, context, highlights, related } = Astro.props;
---

<article class="experience">
  <h3 class="experience__title">{role}, {company}</h3>
  <p class="experience__meta">{period}, {location}</p>
  <p class="experience__context">{context}</p>
  <ul class="experience__list">
    {highlights.map((item) => <li>{item}</li>)}
  </ul>
  {related && <a class="experience__related" href={related.href}>{related.label}</a>}
</article>

<style>
  .experience {
    display: grid;
    gap: var(--space-2);
  }

  .experience + .experience {
    margin-top: var(--space-8);
  }

  .experience__title {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.25;
  }

  .experience__meta {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .experience__context {
    margin-top: var(--space-2);
  }

  .experience__list {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-4);
    list-style: disc;
    max-width: var(--measure);
  }

  .experience__list li::marker {
    color: var(--color-text-muted);
  }

  .experience__related {
    justify-self: start;
    color: var(--color-text);
    font-weight: 500;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .experience__related:hover {
    color: var(--color-accent);
  }
</style>
