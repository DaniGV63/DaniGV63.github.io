---
import { emgShape } from '../../lib/homeArt';

const { traces, cells } = emgShape(760, 460);
---

<svg viewBox="0 0 760 460" role="img" aria-label="Illustration of electromyography signals and the spectrogram built from them">
  {traces.map((d, i) => <path class="emg-trace" d={d} pathLength="1" style={`--t:${i * 0.25}s`}></path>)}
  {
    cells.map((cell) => (
      <rect
        class="emg-cell"
        x={cell.x.toFixed(1)}
        y={cell.y.toFixed(1)}
        width={cell.w.toFixed(1)}
        height={cell.h.toFixed(1)}
        rx="3"
        style={`--o:${cell.level.toFixed(2)};--c:${cell.column}`}
      ></rect>
    ))
  }
  <rect class="emg-scan" x="0" y="20" width="3" height="420" rx="1.5"></rect>
</svg>

<style is:global>
  .emg-trace {
    fill: none;
    stroke: var(--art-ink);
    stroke-width: 1.8;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    opacity: 0.8;
  }

  .emg-cell {
    fill: var(--art-violet);
    opacity: var(--o);
  }

  .emg-scan {
    fill: var(--art-ink);
    opacity: 0;
  }

  .art.on .emg-trace {
    animation: emg-draw 1.8s ease both;
    animation-delay: var(--t);
  }

  .art.on .emg-cell {
    animation: emg-cell 3.8s ease-in-out infinite;
    animation-delay: calc(var(--c) * 0.19s);
  }

  .art.on .emg-scan {
    opacity: 0.75;
    animation: emg-scan 3.8s linear infinite;
  }

  @keyframes emg-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes emg-cell {
    0%,
    55%,
    100% {
      opacity: var(--o);
    }
    25% {
      opacity: 1;
    }
  }

  @keyframes emg-scan {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(757px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .art.on .emg-scan {
      opacity: 0;
    }
  }
</style>
