---
import { isExternal } from '../../lib/assets';

interface Strength {
  id: string;
  title: string;
  metric: string;
  text: string;
  href: string;
  linkLabel: string;
}

interface Props {
  items: readonly Strength[];
}

const { items } = Astro.props;
---

<ul class="proofs">
  {
    items.map((item) => (
      <li class="proof">
        <p class="proof__metric">{item.metric}</p>
        <h3 class="proof__title">{item.title}</h3>
        <p class="proof__text">{item.text}</p>
        <a href={item.href} rel={isExternal(item.href) ? 'noopener' : undefined}>
          {item.linkLabel}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .proofs {
    display: grid;
    gap: var(--space-8);
  }

  .proof {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .proof__metric {
    color: var(--color-accent);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .proof__title {
    font-size: var(--step-0);
    font-weight: 600;
  }

  .proof__text {
    color: var(--color-text-muted);
  }

  .proof a {
    justify-self: start;
    color: var(--color-text);
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  @media (min-width: 640px) {
    .proofs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-12);
    }
  }
</style>
