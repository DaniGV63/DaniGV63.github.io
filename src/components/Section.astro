---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="section">
  <div class="container">
    <h2 id={`${id}-title`} class="section__title label">{title}</h2>
    <slot />
  </div>
</section>

<style>
  .section {
    margin-top: var(--space-16);
  }

  .section__title {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-weight: 500;
  }
</style>
