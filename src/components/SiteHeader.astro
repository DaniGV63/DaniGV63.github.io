---
import profile from '../data/profile.json';
import ThemeToggle from './ThemeToggle.astro';
import { publicFileExists } from '../lib/assets';

const hasCv = publicFileExists(profile.links.cv);

const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  ...(hasCv ? [{ href: profile.links.cv, label: 'CV' }] : []),
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <a class="site-header__name" href="/">{profile.name}</a>
  <nav class="site-header__nav" aria-label="Main">
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
  <ThemeToggle />
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    padding: var(--space-4) var(--page-pad);
  }

  .site-header__name {
    margin-right: auto;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .site-header__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
  }

  .site-header__nav a {
    color: var(--color-text-muted);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .site-header__nav a:hover {
    color: var(--color-text);
  }
</style>
