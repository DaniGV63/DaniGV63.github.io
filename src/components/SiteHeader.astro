---
import profile from '../data/profile.json';
import ThemeToggle from './ThemeToggle.astro';
import { publicFileExists } from '../lib/assets';

const hasCv = publicFileExists(profile.links.cv);

const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  ...(hasCv ? [{ href: profile.links.cv, label: 'CV' }] : []),
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__name" href="/">{profile.name}</a>
    <ThemeToggle />
    <nav class="site-header__nav" aria-label="Main">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }

  .site-header__name {
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .site-header__nav {
    grid-column: 1 / -1;
  }

  .site-header__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
  }

  .site-header__nav a {
    color: var(--color-text-muted);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .site-header__nav a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  @media (min-width: 640px) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto;
    }

    .site-header__nav {
      grid-row: 1;
      grid-column: 2;
      justify-self: end;
    }

    .site-header__inner > :global(.theme-toggle) {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
