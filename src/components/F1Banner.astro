---
// Decorative banner for the F1 project card: the real circuit outline from the
// pipeline data, a chequered edge and a comet that runs the lap on hover.
import track from '../data/f1/2021-abu-dhabi-grand-prix-r/track.json';
import { orient, boundsOf, type Point } from '../scripts/f1/circuit';

const W = 600;
const H = 240;
const PAD = 26;
const points = orient(track.outline as Point[], track.rotationDeg);
const box = boundsOf(points);
const scale = Math.min((W - 2 * PAD) / (box.maxX - box.minX), (H - 2 * PAD) / (box.maxY - box.minY));
const offsetX = (W - (box.maxX - box.minX) * scale) / 2 - box.minX * scale;
const offsetY = (H - (box.maxY - box.minY) * scale) / 2 - box.minY * scale;
const d =
  points
    .map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${(x * scale + offsetX).toFixed(1)},${(y * scale + offsetY).toFixed(1)}`)
    .join('') + 'Z';
---

<div class="banner" aria-hidden="true">
  <span class="banner__stripes"></span>
  <svg class="banner__svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMaxYMid meet">
    <path class="banner__base" d={d} />
    <path class="banner__line" d={d} pathLength="100" />
    <path class="banner__comet" d={d} pathLength="100" />
  </svg>
  <span class="banner__check"></span>
</div>

<style>
  .banner {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
    background:
      radial-gradient(120% 140% at 85% 50%, rgb(225 6 0 / 0.22), transparent 55%),
      linear-gradient(100deg, #0b0b0f 25%, #14141b 100%);
  }

  .banner__stripes {
    position: absolute;
    inset: -20% -10%;
    background: repeating-linear-gradient(
      115deg,
      transparent 0 26px,
      rgb(225 6 0 / 0.1) 26px 30px
    );
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .banner__svg {
    position: absolute;
    right: 0;
    top: 0;
    width: 70%;
    height: 100%;
    opacity: 0.9;
  }

  .banner__base {
    fill: none;
    stroke: #2c2c38;
    stroke-width: 9;
    stroke-linejoin: round;
  }

  .banner__line {
    fill: none;
    stroke: #6b6b7a;
    stroke-width: 1.6;
    stroke-linejoin: round;
    transition: stroke 0.3s;
  }

  .banner__comet {
    fill: none;
    stroke: #e10600;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 0 100;
    filter: drop-shadow(0 0 4px rgb(225 6 0 / 0.9));
  }

  .banner__check {
    position: absolute;
    inset: 0 0 auto 0;
    height: 6px;
    background:
      conic-gradient(#f5f5f5 25%, #111 0 50%, #f5f5f5 0 75%, #111 0) 0 0 / 12px 12px;
    opacity: 0.85;
  }

  :global(.card--banner:hover) .banner__stripes {
    transform: translateX(-34px);
  }

  :global(.card--banner:hover) .banner__line {
    stroke: #e8e8f0;
  }

  :global(.card--banner:hover) .banner__comet {
    stroke-dasharray: 9 91;
    animation: lap 2.6s linear infinite;
  }

  @keyframes lap {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: -100;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.card--banner:hover) .banner__comet {
      animation: none;
      stroke-dasharray: 9 91;
    }

    .banner__stripes {
      transition: none;
    }
  }

  @media (max-width: 560px) {
    .banner__svg {
      width: 100%;
      opacity: 0.45;
    }
  }
</style>
