---
import profile from '../data/profile.json';
import { publicFileExists } from '../lib/assets';

const { links } = profile;
const hasCv = publicFileExists(links.cv);
---

<ul class="contact-links">
  {hasCv && <li><a class="contact-links__cv" href={links.cv} download>Download CV (PDF)</a></li>}
  <li><a href={links.linkedin} rel="noopener">LinkedIn</a></li>
  <li><a href={`mailto:${links.email}`} aria-label="Mail Daniel Gómez Verde">Mail</a></li>
</ul>

<style>
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .contact-links a {
    color: var(--color-text);
    font-weight: 500;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .contact-links a:hover {
    color: var(--color-accent);
  }

  .contact-links__cv {
    font-weight: 600;
  }
</style>
