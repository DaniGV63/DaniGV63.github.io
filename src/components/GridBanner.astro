---
// Decorative banner for the Danish power-system card: a cloud of hours sorted into
// three types, with an inertia curve. Synthetic shapes, not the real data.
const W = 600;
const H = 240;
let seed = 11;
const random = (): number => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};
const groups = [
  { cx: 210, cy: 150, color: 'a' },
  { cx: 330, cy: 100, color: 'b' },
  { cx: 450, cy: 70, color: 'c' },
];
const dots = groups.flatMap((group) =>
  Array.from({ length: 70 }, () => ({
    x: group.cx + (random() - 0.5) * 120 + (random() - 0.5) * 40,
    y: group.cy + (random() - 0.5) * 70 + (random() - 0.5) * 30,
    color: group.color,
  })),
);
const curve = Array.from({ length: 40 }, (_, i) => {
  const x = 150 + i * 10;
  const y = 190 - 40 * Math.sin(i / 5) - i * 1.2;
  return `${i === 0 ? 'M' : 'L'}${x},${y.toFixed(1)}`;
}).join('');
---

<div class="banner" aria-hidden="true">
  <span class="banner__grid"></span>
  <svg class="banner__svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMaxYMid meet">
    <path class="curve" d={curve} pathLength="100" />
    <path class="curve curve--live" d={curve} pathLength="100" />
    {dots.map((dot) => <circle class={`dot dot--${dot.color}`} cx={dot.x.toFixed(1)} cy={dot.y.toFixed(1)} r="3" />)}
  </svg>
</div>

<style>
  .banner {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
    background:
      radial-gradient(120% 140% at 85% 50%, rgb(240 163 10 / 0.18), transparent 55%),
      linear-gradient(100deg, #0b0b0f 25%, #14141b 100%);
  }

  .banner__grid {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(0deg, transparent 0 39px, rgb(255 255 255 / 0.04) 39px 40px),
      repeating-linear-gradient(90deg, transparent 0 59px, rgb(255 255 255 / 0.04) 59px 60px);
  }

  .banner__svg {
    position: absolute;
    right: 0;
    top: 0;
    width: 70%;
    height: 100%;
  }

  .dot {
    opacity: 0.8;
    transition:
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.3s;
  }

  .dot--a {
    fill: #56b4e9;
  }

  .dot--b {
    fill: #e69f00;
  }

  .dot--c {
    fill: #cc79a7;
  }

  .curve {
    fill: none;
    stroke: #3a3a46;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .curve--live {
    stroke: #f0a30a;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 0 100;
    filter: drop-shadow(0 0 4px rgb(240 163 10 / 0.8));
  }

  :global(.card--banner:hover) .curve--live {
    stroke-dasharray: 100 0;
    transition: stroke-dasharray 1.8s ease-out;
  }

  :global(.card--banner:hover) .dot {
    transform: translateY(-3px);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.card--banner:hover) .curve--live {
      transition: none;
    }

    .dot {
      transition: none;
    }
  }

  @media (max-width: 560px) {
    .banner__svg {
      width: 100%;
      opacity: 0.45;
    }
  }
</style>
